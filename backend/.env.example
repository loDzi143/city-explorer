# MapTiler key for the geocoding proxy: https://cloud.maptiler.com/account/keys/
MAPTILER_KEY=
GEOCODING_URL=https://api.maptiler.com/geocoding

# OpenRouter key, model id, and chat completions URL: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_COMPLETIONS_URL=https://openrouter.ai/api/v1/chat/completions

# PostgreSQL for accounts, sessions and account trips. Guests and /api/chat work without it.
# `docker compose up -d db` in the repository root starts a matching local server.
DATABASE_URL=postgres://city_explorer:city_explorer@localhost:5432/city_explorer

# Browser origins allowed to call the API with the session cookie, comma-separated.
# Any http://localhost:<port> is allowed outside production.
CORS_ORIGINS=

# Number of trusted reverse proxies in front of the backend: false (none), true (one) or a number.
# Rate limits take the client address from X-Forwarded-For, counting that many entries from the end.
# Without a proxy the header can be forged by the client, so run production behind one.
TRUST_PROXY=false
